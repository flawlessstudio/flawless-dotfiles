{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flawlessstudio/flawless-dotfiles/blob/main/manifests/sources.schema.json",
  "title": "Flawless external source composition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "clone_url", "branch", "commit", "destination", "role", "required"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "repository": {
          "type": "string",
          "minLength": 3
        },
        "clone_url": {
          "type": "string",
          "pattern": "^(https://|ssh://|git@)"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "destination": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": "string",
          "enum": ["active", "frozen", "reference", "deprecated", "archived"]
        },
        "private": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
