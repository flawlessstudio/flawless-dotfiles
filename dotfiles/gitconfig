[core]
  pager = delta
  editor = nvim
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  light = false
  side-by-side = true
  line-numbers = true
  syntax-theme = base16
[merge]
  conflictstyle = diff3
[diff]
  colorMoved = default
[pull]
  rebase = true
[push]
  autoSetupRemote = true
[alias]
  lg = log --oneline --decorate --graph --all
  st = status -sb
  co = checkout
  br = branch
  ci = commit
  unstage = reset HEAD --
  last = log -1 HEAD
