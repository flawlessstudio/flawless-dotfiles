# Flawless zsh fragment
# Injected as a marker-delimited block. Keep credentials and machine-local state out.

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

# Optional Oh My Zsh compatibility. The environment remains usable without it.
if [[ -d "$HOME/.oh-my-zsh" ]]; then
  export ZSH="$HOME/.oh-my-zsh"
  ZSH_THEME=""
  plugins=(git fzf gh docker kubectl tmux)
  source "$ZSH/oh-my-zsh.sh"
fi

if command -v starship >/dev/null 2>&1; then
  export STARSHIP_CONFIG="$HOME/.config/flawless/starship.toml"
  eval "$(starship init zsh)"
fi
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -la --icons --group-directories-first --git'
  alias lt='eza --tree --icons --level=2'
fi
alias g='git'
alias gs='git status -sb'
alias gd='git diff'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias glog='git log --oneline --decorate --graph --all'
command -v nvim >/dev/null 2>&1 && alias vim='nvim' && alias vi='nvim'
command -v lazygit >/dev/null 2>&1 && alias lg='lazygit'
command -v kubectl >/dev/null 2>&1 && alias k='kubectl'

if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
fi

HISTSIZE=50000
SAVEHIST=50000
HISTFILE="$HOME/.zsh_history"
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY EXTENDED_HISTORY

if [[ -z "${EDITOR:-}" ]]; then
  if command -v nvim >/dev/null 2>&1; then
    export EDITOR=nvim
  elif command -v vim >/dev/null 2>&1; then
    export EDITOR=vim
  else
    export EDITOR=vi
  fi
fi
export VISUAL="${VISUAL:-$EDITOR}"

# Machine-local, non-versioned extension point.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# Preserve the existing mobile/SSH workflow without forcing tmux locally.
if [[ -n "${SSH_CONNECTION:-}" ]] && command -v tmux >/dev/null 2>&1 && [[ -z "${TMUX:-}" ]]; then
  tmux attach-session -t main 2>/dev/null || tmux new-session -s main
fi
